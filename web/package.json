{
  "name": "@portunus/web",
  "version": "0.1.0",
  "description": "Portunus 管理后台（Electron + React + Vite 模板）",
  "main": "src/main/main.js",
  "build": {
    "appId": "com.portunus.app",
    "productName": "Portunus",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/main/**/*",
      "dist/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../portunus${ext}",
        "to": "./portunus${ext}"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Lixiuxiu559",
      "repo": "portunus"
    }
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:web\" \"wait-on tcp:localhost:5173 && pnpm run dev:main\"",
    "dev:web": "vite --open",
    "dev:main": "cross-env NODE_ENV=development electron .",
    "build:go": "cd .. && go build -o portunus .",
    "build": "pnpm run build:go && vite build && electron-builder",
    "build:renderer": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "axios": "^1.18.0",
    "electron": "42.3.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  }
}
