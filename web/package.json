{
  "name": "@portunus/web",
  "version": "0.2.1",
  "description": "Portunus 管理后台（Electron + React + Vite 模板）",
  "author": "Lixiuxiu559",
  "main": "src/main/main.js",
  "build": {
    "appId": "com.portunus.app",
    "productName": "Portunus",
    "compression": "store",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/main/**/*",
      "dist/renderer/**/*",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "extraResources": [
      {
        "from": "bin/${os}",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Portunus-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Portunus-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "executableName": "Portunus",
      "target": [
        "AppImage"
      ],
      "artifactName": "Portunus-${version}-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Lixiuxiu559",
      "repo": "portunus"
    }
  },
  "scripts": {
    "dev": "concurrently \"pnpm run dev:web\" \"wait-on tcp:localhost:5173 && pnpm run dev:main\"",
    "dev:web": "vite --open",
    "dev:main": "cross-env NODE_ENV=development electron .",
    "build:go": "node scripts/build-go.mjs",
    "build": "pnpm run build:go && VITE_BASE=./ vite build && electron-builder",
    "build:renderer": "VITE_BASE=./ vite build",
    "build:mac": "pnpm run build:go && pnpm run build:renderer && electron-builder --mac dmg zip --arm64",
    "build:win": "node scripts/build-go.mjs windows amd64 && pnpm run build:renderer && electron-builder --win nsis zip --x64",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@internationalized/date": "^3.12.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.2",
    "axios": "^1.18.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "42.3.3",
    "electron-builder": "^26.0.12",
    "lucide-react": "^1.34.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  }
}
